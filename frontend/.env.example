# 文件：.env.example
# 项目：Pipker Framework
# 模块：前端运行时配置
# 说明：记录 HTTP 传输层使用的非敏感 Vite 变量。
# 处理逻辑：提供后端 API 前缀和 HTTP 超时时间，不将构建配置耦合到具体部署目标。
# 依赖：Vite 环境变量
# 检索关键词：前端、配置、HTTP
# 作者：holic512
VITE_API_BASE_URL=/api
VITE_HTTP_TIMEOUT_MS=10000

# Vite 仅在开发服务器中读取；不暴露给浏览器运行时。
PIPKER_DEV_BACKEND_ORIGIN=http://localhost:8080
