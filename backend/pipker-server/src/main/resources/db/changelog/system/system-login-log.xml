<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file db/changelog/system/system-login-log.xml
    @project Pipker Framework
    @module Pipker Server
    @description 追加认证生命周期日志表、独立查看权限和管理员登录日志页面。
    @logic 创建不依赖用户外键的不可变登录日志表及查询索引，再为 ADMIN 追加查看权限和动态菜单关系；SUPER_ADMIN 继续由运行时规则自动授权。
    @dependencies Liquibase、system_role、system_menu、system_role_permission、system_role_menu
    @index_tags liquibase、database、authentication、login-log、audit、menu、rbac
    @author holic512
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="system-login-log-schema" author="holic512">
        <createTable tableName="system_login_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_system_login_log" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="event_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="failure_reason" type="VARCHAR(64)"/>
            <column name="client_ip" type="VARCHAR(64)"/>
            <column name="user_agent" type="VARCHAR(512)"/>
            <column name="http_method" type="VARCHAR(16)"/>
            <column name="request_path" type="VARCHAR(255)"/>
            <column name="trace_id" type="VARCHAR(128)"/>
            <column name="occurred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="system_login_log" indexName="idx_system_login_log_occurred_at">
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_login_log" indexName="idx_system_login_log_username_time">
            <column name="username"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_login_log" indexName="idx_system_login_log_client_ip_time">
            <column name="client_ip"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_login_log" indexName="idx_system_login_log_trace_id">
            <column name="trace_id"/>
        </createIndex>
        <createIndex tableName="system_login_log" indexName="idx_system_login_log_event_result_time">
            <column name="event_type"/>
            <column name="result"/>
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="system-login-log-admin-permission-seed" author="holic512">
        <comment>默认 ADMIN 可只读查询认证生命周期日志。</comment>
        <insert tableName="system_role_permission">
            <column name="id" valueNumeric="2090000000000000606"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="permission_code" value="system:login-log:view"/>
        </insert>
    </changeSet>

    <changeSet id="system-login-log-menu-seed" author="holic512">
        <insert tableName="system_menu">
            <column name="id" valueNumeric="2090000000000000307"/>
            <column name="parent_id" valueNumeric="2090000000000000301"/>
            <column name="menu_name" value="登录日志"/>
            <column name="menu_type" value="MENU"/>
            <column name="route_path" value="/system/login-logs"/>
            <column name="route_name" value="SystemLoginLog"/>
            <column name="component_key" value="system/login-log/index"/>
            <column name="icon" value="Document"/>
            <column name="sort" valueNumeric="50"/>
            <column name="visible" valueBoolean="true"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <changeSet id="system-login-log-admin-menu-seed" author="holic512">
        <insert tableName="system_role_menu">
            <column name="id" valueNumeric="2090000000000000706"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="menu_id" valueNumeric="2090000000000000307"/>
        </insert>
    </changeSet>
</databaseChangeLog>
