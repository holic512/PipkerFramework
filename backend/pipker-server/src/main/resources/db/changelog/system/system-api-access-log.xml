<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file db/changelog/system/system-api-access-log.xml
    @project Pipker Framework
    @module Pipker Server
    @description 创建接口访问观测表，并注册接口监控权限、API 资源、动态菜单和默认管理员授权。
    @logic 以预计算小时/日期桶支撑三种数据库的统一聚合，明细仅保存安全元数据；ADMIN 获得只读监控能力，SUPER_ADMIN 继续由运行时规则自动授权。
    @dependencies Liquibase、system_permission、system_api_resource、system_role_permission、system_menu、system_role_menu
    @index_tags liquibase、database、api-log、observability、menu、rbac
    @author holic512
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="system-api-access-log-schema" author="holic512">
        <createTable tableName="system_api_access_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_system_api_access_log" nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="occurred_hour" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="occurred_date" type="DATE"><constraints nullable="false"/></column>
            <column name="service_name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="http_method" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="request_path" type="VARCHAR(512)"><constraints nullable="false"/></column>
            <column name="route_pattern" type="VARCHAR(512)"/>
            <column name="handler_method" type="VARCHAR(512)"/>
            <column name="purpose" type="VARCHAR(255)" defaultValue=""><constraints nullable="false"/></column>
            <column name="remark" type="VARCHAR(500)" defaultValue=""><constraints nullable="false"/></column>
            <column name="http_status" type="INT"><constraints nullable="false"/></column>
            <column name="business_code" type="INT"/>
            <column name="success" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="handler_duration_ms" type="BIGINT"/>
            <column name="duration_ms" type="BIGINT"><constraints nullable="false"/></column>
            <column name="trace_id" type="VARCHAR(128)"/>
            <column name="request_id" type="VARCHAR(64)"/>
            <column name="client_ip" type="VARCHAR(64)"/>
            <column name="exception_type" type="VARCHAR(255)"/>
            <column name="exception_message" type="VARCHAR(1024)"/>
        </createTable>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_occurred_at">
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_route_time">
            <column name="route_pattern"/>
            <column name="http_method"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_success_time">
            <column name="success"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_duration_time">
            <column name="duration_ms"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_trace_id">
            <column name="trace_id"/>
        </createIndex>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_hour">
            <column name="occurred_hour"/>
        </createIndex>
        <createIndex tableName="system_api_access_log" indexName="idx_system_api_log_date">
            <column name="occurred_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="system-api-access-log-permission-seed" author="holic512">
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000208"/>
            <column name="permission_code" value="system:api-log:view"/>
            <column name="permission_name" value="查看接口监控"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="查看接口调用量、成功率、响应耗时和慢请求明细"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="system_role_permission">
            <column name="id" valueNumeric="2090000000000000607"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="permission_code" value="system:api-log:view"/>
        </insert>
    </changeSet>

    <changeSet id="system-api-access-log-api-resource-seed" author="holic512">
        <insert tableName="system_api_resource">
            <column name="id" valueNumeric="2090000000000000427"/>
            <column name="permission_id" valueNumeric="2090000000000000208"/>
            <column name="http_method" value="GET"/>
            <column name="path_pattern" value="/api/admin/api-logs/overview"/>
        </insert>
        <insert tableName="system_api_resource">
            <column name="id" valueNumeric="2090000000000000428"/>
            <column name="permission_id" valueNumeric="2090000000000000208"/>
            <column name="http_method" value="GET"/>
            <column name="path_pattern" value="/api/admin/api-logs/endpoints"/>
        </insert>
        <insert tableName="system_api_resource">
            <column name="id" valueNumeric="2090000000000000429"/>
            <column name="permission_id" valueNumeric="2090000000000000208"/>
            <column name="http_method" value="GET"/>
            <column name="path_pattern" value="/api/admin/api-logs"/>
        </insert>
        <insert tableName="system_api_resource">
            <column name="id" valueNumeric="2090000000000000430"/>
            <column name="permission_id" valueNumeric="2090000000000000208"/>
            <column name="http_method" value="GET"/>
            <column name="path_pattern" value="/api/admin/api-logs/{logId}"/>
        </insert>
    </changeSet>

    <changeSet id="system-api-access-log-menu-seed" author="holic512">
        <insert tableName="system_menu">
            <column name="id" valueNumeric="2090000000000000308"/>
            <column name="parent_id" valueNumeric="2090000000000000301"/>
            <column name="menu_name" value="接口监控"/>
            <column name="menu_type" value="MENU"/>
            <column name="route_path" value="/system/api-monitor"/>
            <column name="route_name" value="SystemApiMonitor"/>
            <column name="component_key" value="system/api-monitor/index"/>
            <column name="icon" value="Monitor"/>
            <column name="sort" valueNumeric="60"/>
            <column name="visible" valueBoolean="true"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="system_role_menu">
            <column name="id" valueNumeric="2090000000000000707"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="menu_id" valueNumeric="2090000000000000308"/>
        </insert>
    </changeSet>
</databaseChangeLog>
