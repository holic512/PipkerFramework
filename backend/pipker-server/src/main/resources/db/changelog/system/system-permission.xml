<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file db/changelog/system/system-permission.xml
    @project Pipker Framework
    @module Pipker Server
    @description 保留历史 API 权限表与既有路径资源数据的兼容基线。
    @logic 创建权限表、权限编码唯一约束和仅允许 API 的检查约束，并保留既有历史数据；运行时有效接口权限由 Java PermissionEnum 统一定义，不从此表读取。
    @dependencies Liquibase、system_permission
    @index_tags liquibase、database、system_permission、seed、legacy、rbac、api
    @author holic512
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 当前授权模型不再保留历史 PAGE 和 BUTTON 权限类型。 -->
    <changeSet id="system-permission-schema-mysql-postgresql" author="holic512" dbms="mysql,postgresql">
        <createTable tableName="system_permission">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_system_permission" nullable="false"/>
            </column>
            <column name="permission_code" type="VARCHAR(128)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_system_permission_code"/>
            </column>
            <column name="permission_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="permission_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(16)" defaultValue="ENABLED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Liquibase 5.0.3 不会为 MySQL 可靠地从 column constraints 生成 CHECK，显式保留最终约束。 -->
        <sql splitStatements="false">ALTER TABLE system_permission ADD CONSTRAINT ck_system_permission_type CHECK (permission_type = 'API')</sql>
    </changeSet>

    <!-- SQLite 需要在建表时内联定义最终 CHECK 约束。 -->
    <changeSet id="system-permission-schema-sqlite" author="holic512" dbms="sqlite">
        <sql splitStatements="false"><![CDATA[
            CREATE TABLE system_permission (
              id BIGINT NOT NULL,
              permission_code VARCHAR(128) NOT NULL,
              permission_name VARCHAR(100) NOT NULL,
              permission_type VARCHAR(16) NOT NULL,
              description VARCHAR(500),
              status VARCHAR(16) NOT NULL DEFAULT 'ENABLED',
              created_at TIMESTAMP NOT NULL,
              updated_at TIMESTAMP NOT NULL,
              CONSTRAINT pk_system_permission PRIMARY KEY (id),
              CONSTRAINT uk_system_permission_code UNIQUE (permission_code),
              CONSTRAINT ck_system_permission_type CHECK (permission_type = 'API')
            )
        ]]></sql>
    </changeSet>

    <changeSet id="system-permission-seed" author="holic512">
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000201"/>
            <column name="permission_code" value="system:authorization:read"/>
            <column name="permission_name" value="读取当前授权信息"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="读取当前用户角色、权限和菜单"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000202"/>
            <column name="permission_code" value="system:auth:me"/>
            <column name="permission_name" value="读取当前授权信息"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="读取当前登录用户的角色、权限和页面菜单"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <changeSet id="system-permission-role-management-seed" author="holic512">
        <comment>角色管理 API：筛选、增删改、批量状态处理、角色成员查看及成员密码重置。</comment>
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000204"/>
            <column name="permission_code" value="system:role:manage"/>
            <column name="permission_name" value="管理系统角色"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="管理普通角色、查看角色成员并重置成员账户密码"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <changeSet id="system-permission-route-management-seed" author="holic512">
        <comment>路由管理 API：只读筛选和查看已落库的路由、页面索引与目录分类定义。</comment>
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000205"/>
            <column name="permission_code" value="system:route:read"/>
            <column name="permission_name" value="查看系统路由"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="查看系统页面路径、路由标识、页面索引、菜单展示状态和目录分类"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <changeSet id="system-permission-user-management-seed" author="holic512">
        <comment>用户管理 API：筛选、详情、创建、编辑、角色分配、批量状态处理、删除和密码重置。</comment>
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000206"/>
            <column name="permission_code" value="system:user:view"/>
            <column name="permission_name" value="查看系统用户"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="查看系统用户列表、账户资料、角色分配和登录记录"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="system_permission">
            <column name="id" valueNumeric="2090000000000000207"/>
            <column name="permission_code" value="system:user:manage"/>
            <column name="permission_name" value="管理系统用户"/>
            <column name="permission_type" value="API"/>
            <column name="description" value="创建、编辑、删除、启停用户，分配角色并重置密码"/>
            <column name="status" value="ENABLED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>
</databaseChangeLog>
