<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file pom.xml
    @project Pipker Framework
    @module Pipker Server
    @description Builds the executable HTTP server and assembles the current Pipker Framework business modules.
    @logic Inherits the parent build defaults, combines the base and project-business modules with the required web and validation starters, and packages the application through Spring Boot.
    @dependencies pipker-framework parent, pipker-base, pipker-business, Spring Boot Web, Spring Boot Validation
    @index_tags maven,module,server,spring-boot
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-server</artifactId>
    <name>Pipker Server</name>
    <description>HTTP server module for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>com.pipker</groupId>
            <artifactId>pipker-base</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pipker</groupId>
            <artifactId>pipker-business</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
