    @file pom.xml
    @project Pipker Framework
    @module Pipker Spring Boot Starter Log
    @description Provides the lightweight dependency boundary for Pipker technical logging infrastructure.
    @logic Supplies Spring Boot's standard logging baseline and reserves this module for future logging-format, MDC, TraceId, request-logging, and desensitization infrastructure only.
    @dependencies pipker-framework parent, Spring Boot Logging Starter
    @index_tags maven,module,starter,logging,spring-boot
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-spring-boot-starter-log</artifactId>

    <name>Pipker Spring Boot Starter Log</name>
    <description>Technical logging infrastructure starter for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
    </dependencies>

</project>
