<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file pom.xml
    @project Pipker Framework
    @module Parent and aggregator build
    @description Defines the shared build baseline and aggregates the currently available server module.
    @logic Inherits Spring Boot dependency and plugin management, then provides Java and encoding defaults to child modules.
    @dependencies Spring Boot Maven parent
    @index_tags maven,parent,aggregator,java-21
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.pipker</groupId>
    <artifactId>pipker-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Pipker Framework</name>
    <description>Parent and aggregator project for Pipker Framework.</description>

    <modules>
        <module>pipker-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- Add non-Spring-Boot dependency versions here only when they are introduced. -->
    <dependencyManagement>
        <dependencies>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Add shared plugin versions or configuration here only when they are introduced. -->
        <pluginManagement>
            <plugins>
            </plugins>
        </pluginManagement>
    </build>

</project>
