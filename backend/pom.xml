<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file pom.xml
    @project Pipker Framework
    @module Parent and Aggregator
    @description 定义统一构建基线，并聚合 Starter、业务和 Server 模块。
    @logic 继承 Spring Boot 的依赖与插件管理；聚合执行 spring-boot:run 时跳过无主类模块，仅由 Server 模块启动应用。
    @dependencies Spring Boot Maven 父工程、Spring Boot Maven Plugin
    @index_tags maven、父工程、聚合、java-21、spring-boot、run
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.pipker</groupId>
    <artifactId>pipker-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Pipker Framework</name>
    <description>Parent and aggregator project for Pipker Framework.</description>

    <modules>
        <module>pipker-starters</module>
        <module>pipker-business</module>
        <module>pipker-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <sa-token.version>1.46.0</sa-token.version>
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-business-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-business-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-satoken</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- 仅在引入共享插件版本或配置时补充。 -->
        <pluginManagement>
            <plugins>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
