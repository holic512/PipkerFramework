# @file .env.example
# @project Pipker Framework
# @module Frontend runtime configuration
# @description Documents non-secret Vite variables consumed by the HTTP transport layer.
# @logic Supplies a backend API prefix and HTTP timeout without coupling build configuration to a deployment target.
# @dependencies Vite environment variables
# @index_tags frontend,configuration,http
# @author holic512
VITE_API_BASE_URL=/api
VITE_HTTP_TIMEOUT_MS=10000

# Vite 仅在开发服务器中读取；不暴露给浏览器运行时。
PIPKER_DEV_BACKEND_ORIGIN=http://localhost:8080
