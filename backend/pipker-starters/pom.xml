<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Starters
    说明：聚合可复用的 Pipker Spring Boot 技术 Starter，不单独生成构件。
    处理逻辑：继承框架构建基线，并将相互独立的技术 Starter 组织到 Reactor 构建中。
    依赖：pipker-framework 父工程
    检索关键词：maven、聚合、starter、spring-boot
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-starters</artifactId>
    <packaging>pom</packaging>

    <name>Pipker Starters</name>
    <description>Maven aggregator for Pipker Spring Boot starter modules.</description>

    <modules>
        <module>pipker-spring-boot-starter-redis</module>
        <module>pipker-spring-boot-starter-log</module>
        <module>pipker-spring-boot-starter-satoken</module>
        <module>pipker-spring-boot-starter-security</module>
    </modules>

</project>
