<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file db/changelog/system/system-role-permission.xml
    @project Pipker Framework
    @module Pipker Server
    @description 定义系统角色与 Java 接口权限编码的多对多关联及系统管理员默认授权。
    @logic 创建独立雪花主键、角色级联外键、角色权限编码唯一约束和编码索引；permission_code 不建立外键，以保留已从 Java 枚举删除的历史编码。
    @dependencies Liquibase、system_role、system_role_permission
    @index_tags liquibase、database、system_role_permission、seed、rbac、permission
    @author holic512
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="system-role-permission-schema-mysql-postgresql" author="holic512" dbms="mysql,postgresql">
        <createTable tableName="system_role_permission">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_system_role_permission" nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="permission_code" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="system_role_permission" columnNames="role_id, permission_code"
                             constraintName="uk_system_role_permission_role_permission"/>
        <addForeignKeyConstraint baseTableName="system_role_permission" baseColumnNames="role_id"
                                 constraintName="fk_system_role_permission_role" referencedTableName="system_role"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="system_role_permission" indexName="idx_system_role_permission_permission_code">
            <column name="permission_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="system-role-permission-schema-sqlite" author="holic512" dbms="sqlite">
        <sql splitStatements="true"><![CDATA[
            CREATE TABLE system_role_permission (
              id BIGINT NOT NULL,
              role_id BIGINT NOT NULL,
              permission_code VARCHAR(128) NOT NULL,
              CONSTRAINT pk_system_role_permission PRIMARY KEY (id),
              CONSTRAINT uk_system_role_permission_role_permission UNIQUE (role_id, permission_code),
              CONSTRAINT fk_system_role_permission_role FOREIGN KEY (role_id)
                REFERENCES system_role (id) ON DELETE CASCADE
            );
            CREATE INDEX idx_system_role_permission_permission_code ON system_role_permission (permission_code);
        ]]></sql>
    </changeSet>

    <changeSet id="system-role-permission-seed" author="holic512">
        <comment>默认 ADMIN 角色可读取授权投影、维护角色权限并查看已落库路由；有效性始终由 Java PermissionEnum 决定。</comment>
        <insert tableName="system_role_permission">
            <column name="id" valueNumeric="2090000000000000601"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="permission_code" value="system-authorization-view"/>
        </insert>
        <insert tableName="system_role_permission">
            <column name="id" valueNumeric="2090000000000000602"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="permission_code" value="system-role-manage"/>
        </insert>
        <insert tableName="system_role_permission">
            <column name="id" valueNumeric="2090000000000000603"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="permission_code" value="system-route-view"/>
        </insert>
    </changeSet>
</databaseChangeLog>
