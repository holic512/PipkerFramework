<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file db/changelog/system/system-api-resource.xml
    @project Pipker Framework
    @module Pipker Server
    @description 保留历史 API 路径资源与历史权限记录的映射基线。
    @logic 创建 API 资源表、方法路径唯一约束和权限外键，再保留既有框架接口资源数据；运行时接口授权由 Permission 注解和 Java PermissionEnum 完成，不再按本表匹配请求路径。
    @dependencies Liquibase、system_api_resource、system_permission
    @index_tags liquibase、database、system_api_resource、seed、legacy、api、rbac
    @author holic512
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="system-api-resource-schema-mysql-postgresql" author="holic512" dbms="mysql,postgresql">
        <createTable tableName="system_api_resource">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_system_api_resource" nullable="false"/>
            </column>
            <column name="permission_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="http_method" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="path_pattern" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="system_api_resource" columnNames="http_method, path_pattern"
                             constraintName="uk_system_api_resource_method_path"/>
        <addForeignKeyConstraint baseTableName="system_api_resource" baseColumnNames="permission_id"
                                 constraintName="fk_system_api_resource_permission" referencedTableName="system_permission"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="system_api_resource" indexName="idx_system_api_resource_permission_id">
            <column name="permission_id"/>
        </createIndex>
    </changeSet>

    <!-- SQLite 外键必须在 CREATE TABLE 中定义，因此保留唯一的 SQLite 专属结构 SQL。 -->
    <changeSet id="system-api-resource-schema-sqlite" author="holic512" dbms="sqlite">
        <sql splitStatements="true"><![CDATA[
            CREATE TABLE system_api_resource (
              id BIGINT NOT NULL,
              permission_id BIGINT NOT NULL,
              http_method VARCHAR(16) NOT NULL,
              path_pattern VARCHAR(255) NOT NULL,
              CONSTRAINT pk_system_api_resource PRIMARY KEY (id),
              CONSTRAINT uk_system_api_resource_method_path UNIQUE (http_method, path_pattern),
              CONSTRAINT fk_system_api_resource_permission FOREIGN KEY (permission_id)
                REFERENCES system_permission (id) ON DELETE CASCADE
            );
            CREATE INDEX idx_system_api_resource_permission_id ON system_api_resource (permission_id);
        ]]></sql>
    </changeSet>

