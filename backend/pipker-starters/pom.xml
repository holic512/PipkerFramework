<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file pom.xml
    @project Pipker Framework
    @module Pipker Starters
    @description Aggregates Pipker's reusable Spring Boot technical starter modules without producing an artifact.
    @logic Inherits the framework build baseline and groups independent technical starters for Reactor builds.
    @dependencies pipker-framework parent
    @index_tags maven,aggregator,starter,spring-boot
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-starters</artifactId>
    <packaging>pom</packaging>

    <name>Pipker Starters</name>
    <description>Maven aggregator for Pipker Spring Boot starter modules.</description>

    <modules>
        <module>pipker-spring-boot-starter-redis</module>
        <module>pipker-spring-boot-starter-log</module>
        <module>pipker-spring-boot-starter-satoken</module>
        <module>pipker-spring-boot-starter-security</module>
    </modules>

</project>
