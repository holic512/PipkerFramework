<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：父工程与聚合构建
    说明：定义统一构建基线，并聚合 Starter、业务和 Server 模块。
    处理逻辑：继承 Spring Boot 的依赖与插件管理，提供 Java 和编码默认配置，并为 Server 组装管理内部业务模块与 Starter 的版本。
    依赖：Spring Boot Maven 父工程
    检索关键词：maven、父工程、聚合、java-21
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.pipker</groupId>
    <artifactId>pipker-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Pipker Framework</name>
    <description>Parent and aggregator project for Pipker Framework.</description>

    <modules>
        <module>pipker-starters</module>
        <module>pipker-business</module>
        <module>pipker-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <sa-token.version>1.46.0</sa-token.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-business-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-business-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-satoken</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pipker</groupId>
                <artifactId>pipker-spring-boot-starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- 仅在引入共享插件版本或配置时补充。 -->
        <pluginManagement>
            <plugins>
            </plugins>
        </pluginManagement>
    </build>

</project>
