<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file pom.xml
    @project Pipker Framework
    @module Pipker Business
    @description Aggregates Pipker's common and dedicated project-business modules without producing an artifact.
    @logic Inherits shared build conventions and groups business modules for Reactor builds; concrete business code belongs to child modules.
    @dependencies pipker-framework parent
    @index_tags maven,aggregator,project-business
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-business</artifactId>
    <packaging>pom</packaging>

    <name>Pipker Business</name>
    <description>Maven aggregator for Pipker Framework business modules.</description>

    <modules>
        <module>pipker-business-common</module>
        <module>pipker-business-api</module>
    </modules>

</project>
