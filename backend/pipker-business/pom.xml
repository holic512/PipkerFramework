<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Business
    说明：聚合 Pipker 公共业务模块和独立项目业务模块，不单独生成构件。
    处理逻辑：继承统一构建约定，并将业务模块组织到 Reactor 构建中；具体业务代码应放在子模块内。
    依赖：pipker-framework 父工程
    检索关键词：maven、聚合、业务模块
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-business</artifactId>
    <packaging>pom</packaging>

    <name>Pipker Business</name>
    <description>Maven aggregator for Pipker Framework business modules.</description>

    <modules>
        <module>pipker-business-common</module>
        <module>pipker-business-api</module>
    </modules>

</project>
