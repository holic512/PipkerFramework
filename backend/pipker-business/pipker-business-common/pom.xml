<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Business Common
    说明：定义跨业务共享的响应、身份和异常契约。
    处理逻辑：继承统一构建约定，提供 LoginType、LoginIdentity、结果码和公共异常，不依赖独立业务模块、技术 Starter 或 Server。
    依赖：pipker-framework 父工程
    检索关键词：maven、模块、业务、公共能力
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-business-common</artifactId>
    <packaging>jar</packaging>

    <name>Pipker Business Common</name>
    <description>Shared response, identity, and exception contracts for Pipker Framework applications.</description>

</project>
