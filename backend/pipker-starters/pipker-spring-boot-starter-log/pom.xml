<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Spring Boot Starter Log
    说明：为 Pipker 技术日志基础设施提供轻量依赖边界。
    处理逻辑：提供 Spring Boot 标准日志基线，并预留日志格式、MDC、TraceId 传递、请求日志和脱敏等基础设施扩展位置。
    依赖：pipker-framework 父工程、Spring Boot Logging Starter
    检索关键词：maven、模块、starter、日志、spring-boot
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-spring-boot-starter-log</artifactId>

    <name>Pipker Spring Boot Starter Log</name>
    <description>Technical logging infrastructure starter for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
    </dependencies>

</project>
