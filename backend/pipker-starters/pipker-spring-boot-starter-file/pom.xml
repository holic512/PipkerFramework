<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file pom.xml
    @project Pipker Framework
    @module Pipker Spring Boot Starter File
    @description 提供默认本地文件持久化、相对访问路径和可选 Spring MVC 文件读取映射。
    @logic 绑定 pipker.file 配置，按开关注册本地文件服务；在 Servlet Web 应用中将公开访问前缀映射到已配置的本地目录。
    @dependencies pipker-framework 父工程、Pipker Common Starter、Spring Boot Validation、可选 Spring Boot Web MVC
    @index_tags maven、starter、file-storage、local、spring-boot、webmvc
    @author holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-spring-boot-starter-file</artifactId>

    <name>Pipker Spring Boot Starter File</name>
    <description>Local file storage and relative public access infrastructure for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>com.pipker</groupId>
            <artifactId>pipker-spring-boot-starter-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
