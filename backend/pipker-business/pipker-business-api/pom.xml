<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Business API
    说明：定义由 Server 组装的 Pipker 独立应用业务模块。
    处理逻辑：继承统一构建约定，仅依赖公共业务能力；新增具体应用业务代码时无需耦合 Server。
    依赖：pipker-framework 父工程、pipker-business-common
    检索关键词：maven、模块、业务、api
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-business-api</artifactId>
    <packaging>jar</packaging>

    <name>Pipker Business API</name>
    <description>Dedicated application business module for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>com.pipker</groupId>
            <artifactId>pipker-business-common</artifactId>
        </dependency>
    </dependencies>

</project>
