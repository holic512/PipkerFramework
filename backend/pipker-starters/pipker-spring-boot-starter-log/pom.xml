<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Spring Boot Starter Log
    说明：为 Pipker 技术日志基础设施提供自动配置、MDC、HTTP 日志、操作日志和脱敏能力。
    处理逻辑：组合公共标识符工具、Spring Boot 日志、自动配置、Jackson 与 AOP 基础设施；Servlet MVC 依赖保持可选，使非 Web 应用可安全使用核心能力。
    依赖：pipker-framework 父工程、Pipker Common Starter、Spring Boot Logging/AutoConfigure/Jackson/AOP Starter、可选 Spring Boot Web MVC
    检索关键词：maven、模块、starter、日志、spring-boot
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-spring-boot-starter-log</artifactId>

    <name>Pipker Spring Boot Starter Log</name>
    <description>Technical logging infrastructure starter for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>com.pipker</groupId>
            <artifactId>pipker-spring-boot-starter-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
