<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件：pom.xml
    项目：Pipker Framework
    模块：Pipker Spring Boot Starter Redis
    说明：为 Pipker Redis 基础设施提供轻量依赖边界。
    处理逻辑：将 Redis 客户端和自动配置能力交给 Spring Boot 官方 Redis Starter；明确需求后可在此增加 Pipker 自有 Redis 基础设施。
    依赖：pipker-framework 父工程、Spring Boot Data Redis Starter
    检索关键词：maven、模块、starter、redis、spring-boot
    作者：holic512
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pipker</groupId>
        <artifactId>pipker-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pipker-spring-boot-starter-redis</artifactId>

    <name>Pipker Spring Boot Starter Redis</name>
    <description>Redis infrastructure starter for Pipker Framework.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>

</project>
