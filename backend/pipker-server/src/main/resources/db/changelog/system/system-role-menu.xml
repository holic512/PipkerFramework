<?xml version="1.0" encoding="UTF-8"?>
<!--
    @file db/changelog/system/system-role-menu.xml
    @project Pipker Framework
    @module Pipker Server
    @description 定义系统角色与动态菜单的多对多关联及系统管理员默认路由。
    @logic 创建独立雪花主键、关联唯一约束、级联外键和菜单索引，再为 ADMIN 分配角色管理和只读路由管理页面。
    @dependencies Liquibase、system_role、system_menu、system_role_menu
    @index_tags liquibase、database、system_role_menu、seed、rbac、route
    @author holic512
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="system-role-menu-schema-mysql-postgresql" author="holic512" dbms="mysql,postgresql">
        <createTable tableName="system_role_menu">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_system_role_menu" nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="menu_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="system_role_menu" columnNames="role_id, menu_id"
                             constraintName="uk_system_role_menu_role_menu"/>
        <addForeignKeyConstraint baseTableName="system_role_menu" baseColumnNames="role_id"
                                 constraintName="fk_system_role_menu_role" referencedTableName="system_role"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="system_role_menu" baseColumnNames="menu_id"
                                 constraintName="fk_system_role_menu_menu" referencedTableName="system_menu"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="system_role_menu" indexName="idx_system_role_menu_menu_id">
            <column name="menu_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="system-role-menu-schema-sqlite" author="holic512" dbms="sqlite">
        <sql splitStatements="true"><![CDATA[
            CREATE TABLE system_role_menu (
              id BIGINT NOT NULL,
              role_id BIGINT NOT NULL,
              menu_id BIGINT NOT NULL,
              CONSTRAINT pk_system_role_menu PRIMARY KEY (id),
              CONSTRAINT uk_system_role_menu_role_menu UNIQUE (role_id, menu_id),
              CONSTRAINT fk_system_role_menu_role FOREIGN KEY (role_id)
                REFERENCES system_role (id) ON DELETE CASCADE,
              CONSTRAINT fk_system_role_menu_menu FOREIGN KEY (menu_id)
                REFERENCES system_menu (id) ON DELETE CASCADE
            );
            CREATE INDEX idx_system_role_menu_menu_id ON system_role_menu (menu_id);
        ]]></sql>
    </changeSet>

    <changeSet id="system-role-menu-user-management-seed" author="holic512">
        <comment>为 ADMIN 分配用户管理菜单，用于维护普通用户、角色分配和账户状态。</comment>
        <insert tableName="system_role_menu">
            <column name="id" valueNumeric="2090000000000000704"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="menu_id" valueNumeric="2090000000000000303"/>
        </insert>
    </changeSet>

    <changeSet id="system-role-menu-role-management-seed" author="holic512">
        <comment>为 ADMIN 分配角色管理菜单，页面用于角色增删改、批量处理、详情成员查看及密码重置。</comment>
        <insert tableName="system_role_menu">
            <column name="id" valueNumeric="2090000000000000702"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="menu_id" valueNumeric="2090000000000000304"/>
        </insert>
    </changeSet>

    <changeSet id="system-role-menu-route-management-seed" author="holic512">
        <comment>为 ADMIN 分配路由管理菜单，用于只读查看页面路径、索引、路由和菜单展示状态。</comment>
        <insert tableName="system_role_menu">
            <column name="id" valueNumeric="2090000000000000703"/>
            <column name="role_id" valueNumeric="2090000000000000102"/>
            <column name="menu_id" valueNumeric="2090000000000000305"/>
        </insert>
    </changeSet>
</databaseChangeLog>
